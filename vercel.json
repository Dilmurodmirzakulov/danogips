{
  "outputDirectory": "www.danogips.ru",
  "rewrites": [
    {
      "source": "/api/danogips/:path*",
      "destination": "https://api.uzchem.uz/api/danogips/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/uz/",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "/uz/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/widgets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/uz/(.*)",
      "headers": [
        {
          "key": "Content-Language",
          "value": "uz"
        }
      ]
    },
    {
      "source": "/:path((?!uz/).*)",
      "headers": [
        {
          "key": "Content-Language",
          "value": "ru"
        }
      ]
    }
  ]
}


